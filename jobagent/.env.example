# Copy to .env (never commit it). No Gmail password is ever used - Gmail uses OAuth (see README).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Database: SQLite by default. For Supabase use the Postgres connection string:
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=sqlite:///data/jobagent.db

# Job sources (free keys). Each is optional; disabled automatically when the key is missing.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
RAPIDAPI_KEY=          # JSearch API: aggregates Google for Jobs (Indeed/LinkedIn/Glassdoor listings) legitimately

# Optional: finds a company's official website when the job listing lacks it (Brave Search API)
BRAVE_API_KEY=

# gmail = real sending (after `python -m app.cli gmail-auth`); dryrun = writes .eml files to outbox/, sends nothing
MAILER=dryrun

# Protects the dashboard. REQUIRED if you bind to anything other than 127.0.0.1
DASHBOARD_TOKEN=
