// StaffTO entity schema — deployed with `base44 entities push` (or `base44 deploy`).
{
  "name": "Report",
  "description": "User reports of content (jobs, classifieds, employers, messages).",
  "type": "object",
  "properties": {
    "reporter_id": {
      "type": "string",
      "description": "Reporter user id"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "job",
        "classified",
        "employer",
        "message",
        "user"
      ],
      "description": "What was reported"
    },
    "target_id": {
      "type": "string",
      "description": "Target id"
    },
    "target_title": {
      "type": "string",
      "description": "Target title"
    },
    "reason": {
      "type": "string",
      "enum": [
        "scam",
        "discriminatory",
        "misleading_pay",
        "inappropriate",
        "duplicate",
        "sold_or_filled",
        "other"
      ],
      "description": "Reason"
    },
    "details": {
      "type": "string",
      "description": "Details",
      "maxLength": 2000
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "resolved",
        "dismissed"
      ],
      "description": "Status",
      "default": "open"
    },
    "resolution_note": {
      "type": "string",
      "description": "Admin note"
    }
  },
  "required": [
    "reporter_id",
    "target_type",
    "target_id",
    "reason"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.reporter_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
