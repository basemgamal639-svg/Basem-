// StaffTO entity schema — deployed with `base44 entities push` (or `base44 deploy`).
{
  "name": "Notification",
  "description": "In-app notification. Created by functions; owner reads and marks as read.",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Recipient"
    },
    "type": {
      "type": "string",
      "description": "Type"
    },
    "title": {
      "type": "string",
      "description": "Title"
    },
    "body": {
      "type": "string",
      "description": "Body"
    },
    "link": {
      "type": "string",
      "description": "In-app link"
    },
    "read": {
      "type": "boolean",
      "description": "Read",
      "default": false
    }
  },
  "required": [
    "user_id",
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
