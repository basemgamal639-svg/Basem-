// StaffTO entity schema — deployed with `base44 entities push` (or `base44 deploy`).
{
  "name": "Message",
  "description": "Platform message between an employer and an applicant, or a buyer and a classified seller.",
  "type": "object",
  "properties": {
    "thread_key": {
      "type": "string",
      "description": "Stable thread key, e.g. app:<applicationId> or cls:<listingId>:<buyerId>"
    },
    "context_type": {
      "type": "string",
      "enum": [
        "application",
        "classified"
      ],
      "description": "What the thread is about"
    },
    "context_id": {
      "type": "string",
      "description": "Application or listing id"
    },
    "context_title": {
      "type": "string",
      "description": "Thread title"
    },
    "sender_id": {
      "type": "string",
      "description": "Sender user id"
    },
    "sender_name": {
      "type": "string",
      "description": "Sender display name"
    },
    "recipient_id": {
      "type": "string",
      "description": "Recipient user id"
    },
    "recipient_name": {
      "type": "string",
      "description": "Recipient display name"
    },
    "body": {
      "type": "string",
      "description": "Message body",
      "maxLength": 4000
    },
    "read": {
      "type": "boolean",
      "description": "Read by recipient",
      "default": false
    }
  },
  "required": [
    "thread_key",
    "sender_id",
    "recipient_id",
    "body"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
