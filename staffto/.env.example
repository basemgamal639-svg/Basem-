# Set automatically by `base44 dev` / `base44 build` / `base44 deploy`
VITE_BASE44_APP_ID=
VITE_BASE44_APP_BASE_URL=
# Optional branding defaults (runtime overrides live in Admin → Settings → Branding)
VITE_BRAND_NAME=StaffTO
VITE_SITE_URL=https://staffto.ca
# Backend secrets are NOT set here — use: npx base44 secrets set STRIPE_SECRET_KEY=... STRIPE_WEBHOOK_SECRET=... SITE_URL=...
