// StaffTO entity schema — deployed with `base44 entities push` (or `base44 deploy`).
{
  "name": "SavedJob",
  "description": "A job saved by a job seeker.",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner"
    },
    "job_id": {
      "type": "string",
      "description": "Job id"
    },
    "job_title": {
      "type": "string",
      "description": "Title"
    },
    "employer_name": {
      "type": "string",
      "description": "Employer"
    }
  },
  "required": [
    "user_id",
    "job_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
