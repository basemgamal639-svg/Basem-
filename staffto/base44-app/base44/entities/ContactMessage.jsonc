// StaffTO entity schema — deployed with `base44 entities push` (or `base44 deploy`).
{
  "name": "ContactMessage",
  "description": "Messages from the public contact form.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name"
    },
    "email": {
      "type": "string",
      "description": "Email",
      "format": "email"
    },
    "topic": {
      "type": "string",
      "enum": [
        "general",
        "employer_sales",
        "support",
        "privacy",
        "press"
      ],
      "description": "Topic"
    },
    "message": {
      "type": "string",
      "description": "Message",
      "maxLength": 4000
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "handled"
      ],
      "description": "Status",
      "default": "new"
    }
  },
  "required": [
    "name",
    "email",
    "message"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
