{
  "name": "staffto",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "StaffTO — Toronto & GTA hospitality recruitment marketplace on Base44",
  "scripts": {
    "dev": "vite",
    "dev:local": "VITE_LOCAL_BACKEND=1 vite",
    "build": "node scripts/build-sitemap.mjs && vite build",
    "build:local": "node scripts/build-sitemap.mjs && VITE_LOCAL_BACKEND=1 vite build",
    "preview": "vite preview",
    "test": "node --test test/unit.test.mjs",
    "sync:shared": "node scripts/sync-shared.mjs",
    "backend:local": "node test/local-backend/server.mjs --port 4400",
    "serve:local": "npm run build:local && node test/local-backend/server.mjs --port 4400 --static dist",
    "e2e": "node test/e2e/run.mjs"
  },
  "dependencies": {
    "@base44/sdk": "0.8.59",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@base44/vite-plugin": "^1.0.30",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0"
  }
}
