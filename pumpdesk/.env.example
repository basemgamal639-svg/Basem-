# Dummy placeholders only. Copy to pumpdesk/.secrets/env and replace locally.
# Never commit that file. Never put real tokens, chat ids, or wallet keys here.
APP_TOKEN=change-me-to-a-long-random-string
TG_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:desk@localhost
DESK_HOST=127.0.0.1
DESK_PORT=8787
DATA_PATH=
# Comma-separated exact RPC URLs. The process rejects anything not on this list.
RPC_ALLOWLIST=https://api.mainnet-beta.solana.com,https://api.devnet.solana.com,http://127.0.0.1:8899
# Owner Telegram numeric id. 0 refuses every chat, including the first /start.
DESK_OWNER_CHAT_ID=0
DESK_PUMP_HANDLE=
