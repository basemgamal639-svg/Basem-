# Placeholders only. Copy to pumpdesk/.secrets/env locally. Never commit that file.
# There is no shared bearer. The owner is a public wallet address, not a password.
TG_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:desk@localhost
DESK_HOST=127.0.0.1
DESK_PORT=8787
DATA_PATH=
# Comma-separated exact RPC URLs. The process rejects anything not on this list.
RPC_ALLOWLIST=https://api.mainnet-beta.solana.com,https://api.devnet.solana.com,http://127.0.0.1:8899
# Public owner wallet. Empty refuses login. Do not put a private key here.
DESK_OWNER_WALLET=
DESK_OWNER_CHAT_ID=0
DESK_PUMP_HANDLE=
# 1 refuses to deliver Telegram. Tests set 0. Default in code is 1 when unset.
NOTIFY_DELIVER=0
DESK_OFFLINE=0
