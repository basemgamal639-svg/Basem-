# Copy to your hosting provider's environment settings (this app does not read .env files itself).
PORT=3000
NODE_ENV=production
# Required in production — password for /admin (use 12+ characters)
ADMIN_PASSWORD=change-me-to-a-long-password
# Public URL of the site (used for canonical links, sitemap, social sharing)
SITE_URL=https://www.your-domain.com
# Set to 1 when running behind a reverse proxy / load balancer (Render, Railway, Nginx…)
TRUST_PROXY=1
# Optional: database file location (default: data/shop.db)
# DB_PATH=/var/data/shop.db
