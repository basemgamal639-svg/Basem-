# Set these in your hosting provider's environment settings (the app does not read .env files itself).
PORT=3000
NODE_ENV=production          # hides all [placeholders] from visitors
ADMIN_PASSWORD=change-me-to-a-long-password
SITE_URL=https://www.your-domain.com
TRUST_PROXY=1                # when behind a proxy/load balancer (Render, Railway, Nginx…)
TZ=America/New_York          # the workshop's time zone — booking slots use it
# DB_PATH=/var/data/shop.db  # put the database on persistent storage

# Email alerts for new appointment requests and messages (optional)
NOTIFY_TO=bookings@your-domain.com
NOTIFY_FROM=Website <no-reply@your-domain.com>
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=1              # for port 465
